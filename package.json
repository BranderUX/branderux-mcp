{
  "name": "@brander/mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "BranderUX MCP server — let your agent create and control BranderUX projects, custom elements, screens and API keys, with one-click browser OAuth.",
  "homepage": "https://branderux.com/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BranderUX/branderux-mcp.git"
  },
  "license": "MIT",
  "bin": {
    "branderux-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "src/docs/"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "branderux",
    "generative-ui",
    "agentic-apps",
    "claude",
    "oauth"
  ],
  "scripts": {
    "build": "npm run build:app && tsc && rm -rf dist/docs && cp -R src/docs dist/docs",
    "build:app": "vite build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@brander/mcp-tools": "^0.3.0",
    "@modelcontextprotocol/ext-apps": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "sucrase": "^3.35.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^6.0.0",
    "@mui/system": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.12.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.4",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
